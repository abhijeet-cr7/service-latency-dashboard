# Copy to .env.local to override defaults. Every value is optional.
# NOTE: VITE_* variables are compiled into the public bundle. NEVER put secrets
# (API keys, tokens) here. Auth tokens are supplied at runtime, in memory only.

# WebSocket endpoint. Leave empty to use the built-in simulated stream.
# Must be wss:// in production builds (ws:// is only accepted in dev).
VITE_STREAM_URL=

# Max events kept in memory (clamped to 100..50000)
VITE_BUFFER_SIZE=5000

# How often buffered updates are committed to React, in ms (clamped to 50..2000)
VITE_FLUSH_INTERVAL_MS=250
